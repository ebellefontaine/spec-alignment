+import { promises as fs } from 'fs';
+import { glob } from 'fast-glob';
+import type { ConventionName, SourceDocument } from '../core/types.js';
+import type { FilesystemAdapter } from './index.js';
+
+/**
+ * RealFilesystemAdapter: Reads spec files from the filesystem.
+ * Supports glob patterns and reads content from .md and .mdx files.
+ */
+class RealFilesystemAdapter implements FilesystemAdapter {
+  constructor(private repoRoot: string = process.cwd()) {}
+
+  async readSourceDocument(
+    globPattern: string,
+    convention: ConventionName
+  ): Promise<SourceDocument[]> {
+    try {
+      // Match files using glob pattern
+      const files = await glob(globPattern, {
+        cwd: this.repoRoot,
+        absolute: true,
+      });
+
+      const documents: SourceDocument[] = [];
+
+      for (const filePath of files) {
+        // Only process .md and .mdx files
+        if (!filePath.endsWith('.md') && !filePath.endsWith('.mdx')) {
+          continue;
+        }
+
+        try {
+          const content = await fs.readFile(filePath, 'utf-8');
+
+          // Use relative path for the document path
+          const relativePath = filePath.replace(
+            this.repoRoot,
+            ''
+          ).replace(/^[\\/]+/, '');
+
+          documents.push({
+            convention,
+            path: relativePath,
+            content,
+          });
+        } catch (error) {
+          if ((error as NodeJS.ErrnoException).code === 'EISDIR') {
+            // Skip directories
+            continue;
+          }
+          // Re-throw other errors
+          throw error;
+        }
+      }
+
+      return documents;
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+        throw new Error(
+          `Spec path not found: ${globPattern} from ${this.repoRoot}`
+        );
+      }
+      throw error;
+    }
+  }
+}
+
