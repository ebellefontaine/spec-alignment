+ * Factory function to create a FilesystemAdapter instance.
+ * @param repoRoot - Repository root directory (defaults to current working directory)
+ * @returns A new FilesystemAdapter instance
+ */
+export function createFilesystemAdapter(
+  repoRoot: string = process.cwd()
